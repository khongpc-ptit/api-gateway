# ==============================================================================
# FASTIFY API GATEWAY CONFIGURATION (.env.example)
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Frontend CORS Origin (BA - SOA.md §17)
PUBLIC_APP_ORIGIN=http://localhost:5173

# JWT Configuration (BA - SOA.md §4, §19)
JWT_ISSUER=urn:soa:user-service
JWT_AUDIENCE=soa-api
JWT_CLOCK_SKEW_SECONDS=60
# Map of kid to RSA public key in PEM format (JSON stringified)
JWT_PUBLIC_KEYS_JSON={"dev-key-1":"-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA4CHB+xZeYybKNJZn3vOF\nbBBbfLvMW92u/eiNla+SYi/4WGyL74CGdPqx3qHaJ4/3ubQyOyPFBw5xlwLUpjG5\n3/7e5Y8LnIGZoL38O+o85udfuuvUWVoLs3r846xTCZPJTTRTtXfHtZEwaVa3Lwc1\nbUX5AvyVeO+M5eiWRQscO4zE1bVW6bVYBg5wQeLEtXp3KRMstJeOZk297gpPdElO\nzqbYYvI8QQB8rcCE7BlAYfvyqWhGnSjT7t2K6i4s1JgjscWfQhKkp6dgs3IqYqX/\n+NjCnXlLHhn6nshev0wKBjb2TS7mePNN48P4M8a3D0yeQO7oF8CK8/v+hSm+Hod4\n4wIDAQAB\n-----END PUBLIC KEY-----\n"}

# Upstream Services URLs (BA - SOA.md §15, §19)
USER_SERVICE_URL=http://localhost:8081
FARMING_SERVICE_URL=http://localhost:8082
TRADING_SERVICE_URL=http://localhost:8083
CHAT_SERVICE_URL=http://localhost:8084
CHAT_SERVICE_WS_URL=ws://localhost:8084
PAYMENT_SERVICE_URL=http://localhost:8085
NOTIFICATION_SERVICE_URL=http://localhost:8086

# Inter-Service Security
GATEWAY_TO_USER_SERVICE_KEY=gateway-to-user-secret-key-32chars-min
ACCESS_STATE_TIMEOUT_MS=1000
